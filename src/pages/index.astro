---
/**
 * Landing page.
 *
 * Sections §1-§2 (this step) and §3-§6 (Step 5), in the spec's order and
 * reading order. DOM order is the visual order at every breakpoint: no `order`,
 * no `row-reverse`, no grid placement that decouples reading order.
 *
 * Nothing here links to /blog or to any other route. The nav is four same-page
 * anchors, and the section ids come from src/data/sections.ts so a header link
 * and its target cannot drift apart.
 */
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import MateriLayanan from "../components/MateriLayanan.astro";
---

<Base>
	<Hero />
	<MateriLayanan />
</Base>
