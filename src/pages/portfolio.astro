---
/**
 * /portfolio -- the full gallery, and the target of the hero's "Lihat
 * Portofolio Kami" link.
 *
 * The homepage band shows eight; this page shows all twelve and nothing else,
 * so it is a wall of work rather than another pitch. The photos come from
 * src/data/portfolio.ts, which documents where they are from and why their alt
 * text is written the way it is.
 */
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import WorkGrid from "../components/WorkGrid.astro";
import { portfolio } from "../data/portfolio";

const description =
	"Contoh hasil pengerjaan Pamakarya: laser cutting, laser marking, dan fabrikasi custom untuk kebutuhan industri maupun satuan.";
---

<Base title="Portofolio" description={description}>
	<section class="band band--paper">
		<div class="shell">
			<header class="band__head">
				<h1 class="band__title">Portofolio</h1>
				<p class="band__lede">
					Sebagian hasil pengerjaan kami. Setiap produk dikerjakan mengikuti gambar kerja atau skema
					dari klien, untuk kebutuhan satuan maupun produksi.
				</p>
			</header>

			<WorkGrid
				items={portfolio}
				sizes="(max-width: 399px) 92vw, (max-width: 719px) 45vw, (max-width: 1023px) 30vw, 260px"
			/>
		</div>
	</section>

	<Cta />
</Base>
