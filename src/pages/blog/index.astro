---
/**
 * Blog index.
 *
 * Lists published posts, newest first. Excerpt only -- the full post lives
 * at /blog/[slug].
 */
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";

const {
	entries: posts,
	error,
	cacheHint,
} = await getEmDashCollection("posts", {
	limit: 50,
	orderBy: { published_at: "desc" },
});
Astro.cache.set(cacheHint);

if (error) console.error("Failed to load posts:", error);
---

<Base title="Blog" description="Artikel dari Pamakarya.">
	<div class="blog">
		<h1>Blog</h1>

		{posts.length === 0 ? (
			<p class="blog-empty">Belum ada artikel.</p>
		) : (
			<ul class="post-list">
				{posts.map((post) => (
					<li class="post-item">
						<a href={`/blog/${post.id}`} class="post-link">
							<h2>{post.data.title}</h2>
							{post.data.excerpt && <p>{post.data.excerpt}</p>}
							{post.data.publishedAt && (
								<time datetime={post.data.publishedAt.toISOString()}>
									{post.data.publishedAt.toLocaleDateString("id-ID", {
										day: "numeric",
										month: "long",
										year: "numeric",
									})}
								</time>
							)}
						</a>
					</li>
				))}
			</ul>
		)}
	</div>
</Base>

<style>
	.blog {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--spacing-2xl) var(--spacing-lg);
	}

	.blog h1 {
		font-size: var(--font-size-3xl);
		font-weight: var(--font-weight-heading);
		letter-spacing: var(--tracking-snug);
		margin: 0 0 var(--spacing-2xl);
	}

	.blog-empty {
		color: var(--color-muted);
	}

	.post-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xl);
		margin: 0;
		padding: 0;
	}

	.post-item {
		border-bottom: 1px solid var(--color-border);
		padding-bottom: var(--spacing-xl);
	}

	.post-item:last-child {
		border-bottom: none;
	}

	.post-link {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.post-link h2 {
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		margin: 0 0 var(--spacing-sm);
		transition: opacity var(--transition-fast);
	}

	.post-link:hover h2 {
		opacity: 0.65;
	}

	.post-link p {
		color: var(--color-muted);
		line-height: var(--leading-normal);
		margin: 0 0 var(--spacing-sm);
	}

	.post-link time {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}
</style>
