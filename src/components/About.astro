---
/**
 * About.astro -- the "Tentang Kami" band, anchored #tentang-kami for the
 * primary menu. Every claim traces to what pamakarya.com publishes today:
 * the company sentence and the industries it names. The FAQ's material list
 * fills the right ledger. The 10-year claim is deliberately absent: the
 * client rejects it. Nothing else is invented to fill the layout.
 *
 * Look: industrial and corporate, not startup. A solid navy plate carries the
 * ledger like a spec sheet, the copy sits behind a heavy orange rule, and the
 * type is weighted rather than airy. No eyebrows, no pills, no soft shadows.
 */
import { business } from "../data/site";
---

<section class="band band--paper about" id="tentang-kami">
	<div class="shell about__inner">
		<div class="about__story">
			<h2 class="about__title">Tentang Pamakarya</h2>
			<p class="about__lede">
				Pamakarya adalah perusahaan yang berkomitmen menyediakan solusi terbaik di bidang Laser
				Cutting, Laser Marking, Manufaktur, dan Fabrikasi Custom. Sebagai mitra di industri
				manufaktur, kami menghadirkan layanan yang presisi dan inovatif untuk membantu klien
				mewujudkan ide mereka menjadi produk berkualitas tinggi.
			</p>
			<p class="about__support">
				Kami menggunakan mesin CNC presisi tinggi dan perangkat lunak desain mutakhir untuk
				memastikan setiap proyek memenuhi standar kualitas tertinggi. Tim kami melayani mulai dari
				konsultasi, desain, produksi, hingga pengiriman produk akhir.
			</p>
		</div>

		<div class="about__ledger">
			<div class="about__col">
				<h3 class="about__heading">Material yang kami proses</h3>
				<ul class="about__list" role="list">
					{business.materials.map((material) => (
						<li>{material}</li>
					))}
				</ul>
			</div>

			<div class="about__col">
				<h3 class="about__heading">Industri yang kami layani</h3>
				<ul class="about__list" role="list">
					{business.sectors.map((sector) => (
						<li>{sector}</li>
					))}
				</ul>
			</div>
		</div>
	</div>
</section>

<style>
	.about {
		/* The fixed mainbar survives the scroll; keep the section's top visible. */
		scroll-margin-top: calc(var(--mainbar-h) + 8px);
	}

	.about__inner {
		display: grid;
		/* Half and half: the ledger needs the width for its two columns. */
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(48px, 6vw, 96px);
		align-items: stretch;
	}

	.about__story {
		/* If the ledger outgrows the copy, the copy centres inside the row. */
		display: flex;
		flex-direction: column;
		justify-content: center;
		border-left: 4px solid var(--orange);
		padding-left: clamp(24px, 3vw, 40px);
	}

	.about__title {
		color: var(--ink);
		font-size: clamp(1.75rem, 1rem + 2.4vw, 2.75rem); /* 28 -> 44px */
		font-weight: var(--fw-bold);
		line-height: 1.18;
		letter-spacing: -0.01em;
		margin-bottom: 24px;
	}

	.about__lede,
	.about__support {
		color: var(--ink-2);
		font-size: var(--fs-body);
		line-height: var(--lh-body);
	}

	.about__lede {
		margin-bottom: 16px;
	}

	.about__ledger {
		/* A solid navy plate: the spec-sheet half of the section. */
		background: var(--navy-deep);
		padding: clamp(28px, 3.5vw, 48px);
		display: grid;
		/* Materials beside industries, so the block is seven rows tall, not thirteen. */
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 32px;
		/* Rows keep their padding; the pair sits centred in the plate. */
		align-content: center;
	}

	.about__col {
		display: flex;
		flex-direction: column;
	}

	.about__heading {
		color: var(--on-navy);
		font-size: var(--fs-body-s);
		font-weight: var(--fw-bold);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-bottom: 12px;
	}

	.about__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.about__list li {
		display: flex;
		align-items: center;
		/* Fixed padding, so a six-row ledger and a seven-row ledger match. */
		padding-block: var(--space-12);
		color: rgba(255, 255, 255, 0.92);
		font-size: var(--fs-body);
		line-height: var(--lh-tight);
		border-bottom: 1px solid rgba(255, 255, 255, 0.22);
	}

	.about__list li:first-child {
		border-top: 2px solid var(--orange);
	}

	@media (max-width: 899px) {
		.about__inner {
			grid-template-columns: 1fr;
			gap: 48px;
		}
	}

	@media (max-width: 559px) {
		/* Two columns of 130px tear the headings apart; stack them again. */
		.about__ledger {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
