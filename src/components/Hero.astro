---
/**
 * Hero.astro -- the homepage's first screen, mirroring the reference mock
 * (pamakarya-header-hero.html): a blurred workshop photo under a navy-tinted
 * gradient, copy on the left, WhatsApp CTA plus a ghost link.
 *
 * Height contract: topbar + mainbar + hero == one viewport, exactly. The copy
 * scales with that same height, and 560px is the floor -- the hero is a
 * min-height, so a longer copy grows the section instead of being clipped.
 *
 * Contrast contract: the scrim keeps every string over the photo at 4.5:1
 * (white and white@0.82) and the orange accent at 3:1. The ramp is anchored to
 * the copy column rather than to viewport percentages, and the calc() stops
 * fall past the end on narrow screens, where it degrades to a flat 0.94-0.88
 * wash. Verified against the photo at 390 through 1920 with the copy box dark
 * enough for the strictest of the three.
 */
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import heroPhoto from "../assets/hero-laser.jpg";
import { whatsappLink } from "../data/site";

const waHref = whatsappLink("Halo Pamakarya, saya mau konsultasi soal jasa laser cutting.");
---

<section class="hero">
	<div class="hero__photo" aria-hidden="true">
		<Image
			class="hero__img"
			src={heroPhoto}
			alt=""
			widths={[640, 960, 1280, 1920]}
			sizes="100vw"
			priority
			fetchpriority="high"
		/>
	</div>
	<div class="hero__overlay" aria-hidden="true"></div>

	<div class="shell hero__inner">
		<div class="hero__content on-ink">
			<h1>
				Jasa Laser Cutting &amp; Fabrikasi Custom <br />
				<span class="hero__accent">Logam, Akrilik, dan Kayu</span>
			</h1>
			<p class="hero__lede">
				Melayani pengerjaan laser cutting, laser marking, CNC routing, dan fabrikasi custom untuk
				kebutuhan satuan maupun produksi, sesuai gambar kerja atau skema yang Anda miliki.
			</p>

			<div class="hero__cta">
				<a class="btn btn--primary" href={waHref} target="_blank" rel="noopener">
					<Icon name="whatsapp" size={18} />
					<span>Konsultasi Gratis</span>
				</a>
				<a class="btn btn--ghost" href="/portfolio">
					Lihat Portofolio Kami
					<svg class="btn--icon" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M5 12h14M13 6l6 6-6 6" />
					</svg>
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		background: var(--navy-deep);
		/* The rhythm is a share of the screen the hero has to fit into, so a
		   short window tightens the copy rather than overflowing it. The maxima
		   are the values the screen had at a comfortable height; svh overrides
		   below, these are the vh fallbacks. */
		--hero-pad-y: clamp(24px, 5vh, 72px);
		--hero-fs-h1: clamp(2rem, min(1.1rem + 3vw, 7vh), 3.25rem);
		--hero-gap-sm: clamp(12px, 1.8vh, 20px);
		--hero-gap-md: clamp(14px, 2.4vh, 28px);
		/* Topbar + mainbar + hero == exactly one viewport. */
		min-height: max(560px, calc(100vh - var(--chrome-h)));
	}

	@supports (height: 100svh) {
		.hero {
			--hero-pad-y: clamp(24px, 5svh, 72px);
			--hero-fs-h1: clamp(2rem, min(1.1rem + 3vw, 7svh), 3.25rem);
			--hero-gap-sm: clamp(12px, 1.8svh, 20px);
			--hero-gap-md: clamp(14px, 2.4svh, 28px);
			min-height: max(560px, calc(100svh - var(--chrome-h)));
		}
	}

	/* The photo lives on its own clipped layer, so the softening filter never
	   reaches the text and the blur cannot bleed past the section. */
	.hero__photo {
		position: absolute;
		inset: 0;
		overflow: hidden;
	}

	.hero__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.03);
		filter: blur(1.5px) grayscale(10%) brightness(0.82) saturate(1.05);
	}

	/* Dark through the copy column, thinning to the photo on the right. The
	   calc() anchors keep the dark part under the text at every width; past the
	   gradient's end they collapse, which is the flat wash narrow screens want. */
	.hero__overlay {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.03), transparent 40%),
			linear-gradient(
				100deg,
				rgba(14, 36, 54, 0.94) 0,
				rgba(14, 36, 54, 0.88) calc(50% + 400px),
				rgba(14, 36, 54, 0.46) calc(50% + 640px),
				rgba(14, 36, 54, 0.14) calc(50% + 880px),
				rgba(14, 36, 54, 0.05) 100%
			);
	}

	.hero__inner {
		position: relative;
		z-index: 2;
		width: 100%;
		padding-block: var(--hero-pad-y);
	}

	.hero__content {
		max-width: 640px;
	}

	h1 {
		color: var(--on-navy);
		/* 32 -> 52px, and never taller than the screen the hero has to fit. */
		font-size: var(--hero-fs-h1);
		line-height: 1.18;
		letter-spacing: -0.02em;
		text-wrap: balance;
		margin-bottom: var(--hero-gap-sm);
	}

	.hero__accent {
		color: var(--orange);
	}

	.hero__lede {
		color: rgba(255, 255, 255, 0.82);
		font-size: clamp(1rem, 0.95rem + 0.2vw, 1.125rem); /* 16 -> 18px */
		line-height: var(--lh-body);
		max-width: 490px;
		margin-bottom: var(--hero-gap-md);
	}

	.hero__cta {
		display: flex;
		align-items: center;
		gap: 14px;
		flex-wrap: wrap;
	}

	/* The page's one authored moment: the copy rises in, top to bottom,
	   staggered. Reduced-motion users get the final state via theme.css. */
	@media (prefers-reduced-motion: no-preference) {
		.hero__content > * {
			animation: hero-rise 560ms var(--ease-out) both;
		}

		.hero__content > *:nth-child(2) {
			animation-delay: 70ms;
		}

		.hero__content > *:nth-child(3) {
			animation-delay: 140ms;
		}

		@keyframes hero-rise {
			from {
				opacity: 0;
				translate: 0 18px;
			}
		}
	}

	@media (max-width: 359px) {
		/* At the reflow floor (320px) the headline wraps onto more lines than
		   560px holds: the widest floor wins, so the screen scrolls instead of
		   cutting the CTA. */
		.hero {
			min-height: max(640px, calc(100vh - var(--chrome-h)));
		}

		@supports (height: 100svh) {
			.hero {
				min-height: max(640px, calc(100svh - var(--chrome-h)));
			}
		}

		.btn--ghost {
			padding-inline: 14px;
		}
	}
</style>
