---
/**
 * Hero.astro -- the homepage's first screen, mirroring the reference mock
 * (pamakarya-header-hero.html): a blurred workshop photo under a navy-tinted
 * gradient, copy on the left, trust list, WhatsApp CTA plus a ghost link.
 *
 * Height contract: topbar + mainbar + hero == one viewport, exactly. The
 * hero's height is 100vh minus the chrome token (--chrome-h) the header
 * already exports; svh wins where supported, because on mobile it tracks the
 * visible viewport instead of the one the URL bar borrows.
 *
 * The copy inside scales with that same height: padding, headline size and
 * the gaps between blocks are fractions of the viewport, so a short window
 * tightens the screen instead of spilling out of it. 560px is the floor --
 * below it the page scrolls rather than clipping the CTA.
 */
import Icon from "./Icon.astro";
import { whatsappLink } from "../data/site";

/*
 * Every line traces to what Pamakarya publishes (src/data/site.ts) or the
 * client's own words; no claims of experience it cannot evidence.
 */
const waHref = whatsappLink("Halo Pamakarya, saya mau konsultasi soal jasa laser cutting.");
---

<section class="hero">
	<div class="hero__photo" aria-hidden="true"></div>
	<div class="hero__overlay" aria-hidden="true"></div>

	<div class="shell hero__inner">
		<div class="hero__content on-ink">
			<h1>
				Jasa Laser Cutting &amp; Fabrikasi Custom <br />
				<span class="hero__accent">Logam, Akrilik, dan Kayu</span>
			</h1>
			<p class="hero__lede">
				Melayani pengerjaan laser cutting, laser marking, CNC routing, dan fabrikasi custom untuk
				kebutuhan satuan maupun produksi, sesuai gambar kerja atau skema yang Anda miliki.
			</p>

			<div class="hero__cta">
				<a class="btn btn--primary" href={waHref} target="_blank" rel="noopener">
					<Icon name="whatsapp" size={18} />
					<span>Konsultasi Gratis</span>
				</a>
				<a class="btn btn--ghost" href="/portfolio">
					Lihat Portofolio Kami
					<svg class="btn--icon" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M5 12h14M13 6l6 6-6 6" />
					</svg>
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		overflow: hidden;
		background: var(--navy-deep);
		/* The rhythm is a share of the screen the hero has to fit into, so a
		   short window tightens the copy rather than overflowing it. The maxima
		   are the values the screen had at a comfortable height; svh overrides
		   below, these are the vh fallbacks. */
		--hero-pad-y: clamp(24px, 5vh, 72px);
		--hero-fs-h1: clamp(2rem, min(1.1rem + 3vw, 7vh), 3.25rem);
		--hero-gap-xs: clamp(8px, 1.1vh, 12px);
		--hero-gap-sm: clamp(12px, 1.8vh, 20px);
		--hero-gap-md: clamp(14px, 2.4vh, 28px);
		--hero-gap-lg: clamp(20px, 3.2vh, 36px);
		/* Topbar + mainbar + hero == exactly one viewport. */
		height: max(560px, calc(100vh - var(--chrome-h)));
	}

	@supports (height: 100svh) {
		.hero {
			--hero-pad-y: clamp(24px, 5svh, 72px);
			--hero-fs-h1: clamp(2rem, min(1.1rem + 3vw, 7svh), 3.25rem);
			--hero-gap-xs: clamp(8px, 1.1svh, 12px);
			--hero-gap-sm: clamp(12px, 1.8svh, 20px);
			--hero-gap-md: clamp(14px, 2.4svh, 28px);
			--hero-gap-lg: clamp(20px, 3.2svh, 36px);
			height: max(560px, calc(100svh - var(--chrome-h)));
		}
	}

	/* The photo lives on its own layer so the softening filter never reaches
	   the text above it; the overscan hides the blur's edge. */
	.hero__photo {
		position: absolute;
		inset: -16px;
		background: url("/hero-laser.jpg") center / cover no-repeat;
		filter: blur(1.5px) grayscale(10%) brightness(0.82) saturate(1.05);
		transform: scale(1.03);
	}

	.hero__overlay {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.04), transparent 40%),
			linear-gradient(
				100deg,
				rgba(14, 36, 54, 0.9) 0%,
				rgba(14, 36, 54, 0.95) 24%,
				rgba(14, 36, 54, 0.84) 44%,
				rgba(14, 36, 54, 0.42) 64%,
				rgba(14, 36, 54, 0.12) 82%,
				rgba(14, 36, 54, 0.05) 100%
			),
			radial-gradient(ellipse 900px 600px at 78% 40%, rgba(242, 87, 25, 0.16), transparent 62%);
	}

	.hero__inner {
		position: relative;
		z-index: 2;
		width: 100%;
		padding-block: var(--hero-pad-y);
	}

	.hero__content {
		max-width: 640px;
	}

	h1 {
		color: var(--on-navy);
		/* 32 -> 52px, and never taller than the screen the hero has to fit. */
		font-size: var(--hero-fs-h1);
		line-height: 1.18;
		letter-spacing: -0.02em;
		text-wrap: balance;
		margin-bottom: var(--hero-gap-sm);
	}

	.hero__accent {
		color: var(--orange);
	}

	.hero__lede {
		color: rgba(255, 255, 255, 0.82);
		font-size: clamp(1rem, 0.95rem + 0.2vw, 1.125rem); /* 16 -> 18px */
		line-height: var(--lh-body);
		max-width: 490px;
		margin-bottom: var(--hero-gap-md);
	}

	.hero__badge {
		flex: none;
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: var(--orange);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hero__badge svg {
		width: 10px;
		height: 10px;
		fill: none;
		stroke: #fff;
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.hero__cta {
		display: flex;
		align-items: center;
		gap: 14px;
		flex-wrap: wrap;
	}

	/* The page's one authored moment: the copy rises in, top to bottom,
	   staggered. Reduced-motion users get the final state via theme.css. */
	@media (prefers-reduced-motion: no-preference) {
		.hero__content > * {
			animation: hero-rise 560ms var(--ease-out) both;
		}

		.hero__content > *:nth-child(2) {
			animation-delay: 70ms;
		}

		.hero__content > *:nth-child(3) {
			animation-delay: 140ms;
		}

		.hero__content > *:nth-child(4) {
			animation-delay: 210ms;
		}

		@keyframes hero-rise {
			from {
				opacity: 0;
				translate: 0 18px;
			}
		}
	}

	@media (max-width: 359px) {
		/* At the reflow floor (320px) the headline wraps onto more lines than
		   560px holds: the widest floor wins, so the screen scrolls instead of
		   cutting the CTA. */
		.hero {
			height: max(640px, calc(100vh - var(--chrome-h)));
		}

		@supports (height: 100svh) {
			.hero {
				height: max(640px, calc(100svh - var(--chrome-h)));
			}
		}

		.btn--ghost {
			padding-inline: 14px;
		}
	}
</style>
