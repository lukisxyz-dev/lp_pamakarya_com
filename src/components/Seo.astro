---
import { logo } from "../data/site";
import { getAllFaqs, getAllServices, getSettings } from "../utils/content";
import { siteUrl } from "../utils/site-identity";

interface Props {
	fullTitle: string;
	description: string;
	canonical: string;
	image: string;
	noindex?: boolean;
	faqSchema?: boolean;
}

const { fullTitle, description, canonical, image, noindex, faqSchema } = Astro.props;

const services = await getAllServices();
const settings = await getSettings();
const faqs = (await getAllFaqs()).map((entry) => entry.data);

const areaServed = { "@type": "Country", name: "Indonesia" };
const organizationId = `${siteUrl}/#organization`;

const faqPage = faqSchema
	? {
			"@type": "FAQPage",
			mainEntity: faqs.map((item) => ({
				"@type": "Question",
				name: item.question,
				acceptedAnswer: {
					"@type": "Answer",
					text: [item.answer, ...(item.points ?? [])].join(" "),
				},
			})),
		}
	: null;

const graph = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Organization",
			"@id": organizationId,
			name: settings.companyName,
			url: siteUrl,
			description: settings.description,
			logo: {
				"@type": "ImageObject",
				url: `${siteUrl}${logo.path}`,
				width: logo.width,
				height: logo.height,
			},
			email: settings.email,
			telephone: settings.phone,
			slogan: "Custom Laser Cutting & Fabrikasi",
			contactPoint: [
				{
					"@type": "ContactPoint",
					contactType: "customer service",
					telephone: settings.phone,
					email: settings.email,
					availableLanguage: "id",
					areaServed,
				},
			],
			sameAs: [settings.instagramUrl, settings.tokopediaUrl],
			areaServed,
			knowsAbout: [...services.map((entry) => entry.data.title), ...settings.materials],
			hasOfferCatalog: {
				"@type": "OfferCatalog",
				name: `Layanan ${settings.companyName}`,
				itemListElement: services.map((entry) => ({
					"@type": "Offer",
					itemOffered: {
						"@type": "Service",
						name: entry.data.title,
						...(entry.data.description ? { description: entry.data.description } : {}),
						provider: { "@id": organizationId },
						areaServed,
						serviceAudience: {
							"@type": "BusinessAudience",
							name: settings.sectors.join(", "),
						},
					},
				})),
			},
		},
		...(faqPage ? [faqPage] : []),
	],
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? (
	<meta name="robots" content="noindex, follow" />
) : (
	<>
		<link rel="canonical" href={canonical} />
		<meta property="og:url" content={canonical} />
	</>
)}
<meta property="og:type" content="website" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:locale" content="id_ID" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(graph)}></script>
