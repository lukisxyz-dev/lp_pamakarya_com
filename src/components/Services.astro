---
/**
 * Services.astro -- the "Layanan Kami" band, anchored #jasa.
 *
 * Every unit comes from the Keystatic-managed "services" collection via
 * getLandingServices(): entries without "Tampilkan di beranda" are skipped
 * here while /jasa and the footer still list them. Two units (Laser CO2, CNC
 * Routing) have no description and no image anywhere on the live site, so
 * their cells carry the name over a flat navy tile: an absence, not a
 * substitute -- their entries fail Keystatic's required-photo validation the
 * next time an editor touches them.
 *
 * Look: tiles of the work itself. The photo is the cell's background, the index
 * number and the sentence sit on a scrim at the bottom, and the 1px grid gap
 * lets the band show through instead of drawing hairlines over photographs.
 */
import { getLandingServices } from "../utils/content";

const services = (await getLandingServices()).map((entry, index) => ({
	/** The index printed on the cell: 01, 02, ... */
	index: String(index + 1).padStart(2, "0"),
	name: entry.data.title,
	description: entry.data.description,
	/** Background layers, absent where the entry has no media yet. */
	media: entry.data.image
		? `--still: url(${entry.data.image}); --anim: url(${entry.data.imageAnimated ?? entry.data.image})`
		: undefined,
}));
---

<section class="band band--tint services" id="jasa">
	<div class="shell">
		<header class="band__head">
			<h2 class="band__title">Layanan Kami</h2>
			<p class="band__lede">
				Mulai berkarya bersama Pamakarya, di mana presisi bertemu inovasi. Kami menyediakan solusi
				laser cutting, fabrikasi, dan manufaktur custom untuk mewujudkan ide Anda.
			</p>
		</header>

		<ul class="services__grid" role="list">
			{services.map((service) => (
				<li class="services__cell" style={service.media}>
					<span class="services__index" aria-hidden="true">
						{service.index}
					</span>
					<h3 class="services__name">{service.name}</h3>
					<p class="services__desc">{service.description}</p>
				</li>
			))}
		</ul>

		<p class="services__more">
			<a class="services__link" href="/jasa">
				Lihat detail layanan
				<svg class="btn--icon" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M5 12h14M13 6l6 6-6 6"></path>
				</svg>
			</a>
		</p>
	</div>
</section>

<style>
	.services {
		/* Menu target: clear the fixed mainbar. */
		scroll-margin-top: calc(var(--mainbar-h) + 8px);
	}

	.services__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		/* Equal rows: the two units the live site never describes would
		   otherwise leave their row shorter than the rest. */
		grid-auto-rows: 1fr;
		/* The band shows through the gap: a photo cell cannot carry a hairline. */
		gap: 1px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.services__cell {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		--photo-zone: clamp(72px, 9vw, 120px);
		--text-zone: calc(162px + clamp(20px, 2.2vw, 28px));
		min-height: clamp(190px, 17vw, 240px);
		padding: clamp(20px, 2.2vw, 28px);
		padding-top: calc(clamp(20px, 2.2vw, 28px) + var(--photo-zone));
		/* The tile under every photo -- and the whole cell where there is none. */
		background: var(--navy-deep);
		overflow: hidden;
	}

	/* Two layers: the photo, then the scrim the words sit on. Photographs run
	   from blown-out to near-black, so the scrim is what guarantees contrast. */
	.services__cell::before,
	.services__cell::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	.services__cell::before {
		background: var(--still, none) center / cover no-repeat;
		filter: brightness(0.9);
		transition: scale var(--dur-control) var(--ease-out);
	}

	.services__cell::after {
		background: linear-gradient(
			to top,
			rgba(6, 20, 34, 0.94),
			rgba(6, 20, 34, 0.86) var(--text-zone),
			rgba(6, 20, 34, 0.12)
		);
	}

	.services__cell > * {
		position: relative;
		z-index: 1;
	}

	@media (prefers-reduced-motion: no-preference) and (hover: hover) {
		.services__cell:hover::before {
			background-image: var(--anim, none);
			scale: 1.05;
		}
	}

	.services__index {
		display: grid;
		place-items: center;
		align-self: flex-start;
		width: 26px;
		height: 26px;
		border-radius: 50%;
		background: var(--orange);
		color: var(--navy-deep);
		font-size: var(--fs-label);
		font-weight: var(--fw-bold);
		font-variant-numeric: tabular-nums;
		margin-bottom: 12px;
	}

	.services__name {
		margin: 0;
		min-height: 2.6em;
		color: var(--on-navy);
		font-size: var(--fs-body);
		font-weight: var(--fw-semibold);
		line-height: var(--lh-tight);
		text-wrap: balance;
	}

	.services__desc {
		margin: 10px 0 0;
		min-height: 4.8em;
		color: rgba(255, 255, 255, 0.78);
		font-size: var(--fs-body-s);
		line-height: var(--lh-body);
	}

	.services__more {
		margin: clamp(28px, 3vw, 40px) 0 0;
	}

	.services__link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--orange-deep);
		font-size: var(--fs-body-s);
		font-weight: var(--fw-semibold);
		text-decoration: none;
	}

	.services__link:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.services__link:hover .btn--icon {
		translate: 3px 0;
	}

	/* Four columns need the wide shell; below it the sheet halves, then stacks. */
	@media (max-width: 1023px) {
		.services__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 559px) {
		.services__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
