---
/**
 * Header.astro -- two layers: a navy strip (contact, profiles) over a white bar
 * (logo, `primary` menu, WhatsApp CTA), joined by a 2px orange seam. Sticky; on
 * scroll down the strip translates away and the white bar stays.
 */
import { getMenu, getSiteSettings } from "emdash";
import Icon from "./Icon.astro";
import { contact, whatsappLink } from "../data/site";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const { siteTitle, siteLogo } = resolveStarterSiteIdentity(await getSiteSettings());
const menu = await getMenu("primary");

/* A logo chosen in Settings wins; the bundled one is the fallback. */
const logoUrl = siteLogo?.url ?? "/logo.png";
const logoAlt = siteLogo?.alt || siteTitle;
const logoWidth = siteLogo?.width ?? 1920;
const logoHeight = siteLogo?.height ?? 768;

/* One CTA on the chrome, and the visitor has read nothing yet: it asks. */
const waHref = whatsappLink(
	`Halo ${siteTitle}, saya mau tanya soal jasa laser cutting dan fabrikasi.`,
);

/* `name` prints in the strip, `label` names the link and heads the drawer row. */
const socials = [
	{
		icon: "instagram",
		name: "Instagram",
		label: `Instagram ${contact.instagramHandle}`,
		href: contact.instagramUrl,
	},
	{
		icon: "store",
		name: "Tokopedia",
		label: `Tokopedia ${contact.tokopediaHandle}`,
		href: contact.tokopediaUrl,
	},
	{
		icon: "whatsapp",
		name: "WhatsApp",
		label: `WhatsApp ${contact.whatsappDisplay}`,
		href: waHref,
	},
] as const;

const navItems = menu?.items ?? [];

/* Active state is computed here, not left to the editor: the menu stores
   destinations, the current URL decides which one is current. */
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) => {
	if (!href.startsWith("/")) return false;
	const path = href.replace(/\/+$/, "") || "/";
	return path === "/"
		? currentPath === "/"
		: currentPath === path || currentPath.startsWith(`${path}/`);
};
---

<header class="site-header" data-header data-topbar="shown">
	<div class="topbar">
		<div class="shell topbar__inner">
			<ul class="topbar__contact">
				<li>
					<a class="topbar__phone" href={`tel:${contact.phone}`}>
						{contact.whatsappDisplay}
					</a>
				</li>
				<li class="topbar__email">
					<a href={`mailto:${contact.email}`}>{contact.email}</a>
				</li>
			</ul>

			<div class="topbar__reach">
				<span class="topbar__reachLabel">Ikuti kami</span>
				<ul class="topbar__social">
					{socials.map((social) => (
						<li>
							<a href={social.href} aria-label={social.label} target="_blank" rel="noopener">
								<Icon name={social.icon} size={16} />
								<span>{social.name}</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</div>
	</div>

	<div class="mainbar">
		<div class="shell mainbar__inner">
			<a class="mainbar__logo" href="/" aria-label={`${siteTitle}: beranda`}>
				<img
					src={logoUrl}
					alt={logoAlt}
					width={logoWidth}
					height={logoHeight}
					decoding="async"
					fetchpriority="high"
				/>
			</a>

			<nav class="mainbar__nav" aria-label="Navigasi utama">
				<ul>
					{navItems.map((item) => (
						<li>
							<a
								href={item.url}
								target={item.target}
								aria-current={isCurrent(item.url) ? "page" : undefined}
							>
								{item.label}
							</a>
						</li>
					))}
				</ul>
			</nav>

			<div class="mainbar__actions">
				<a class="cta" href={waHref} target="_blank" rel="noopener">
					<Icon name="whatsapp" size={20} />
					<span>Konsultasi Gratis</span>
				</a>

				<button
					class="burger"
					type="button"
					aria-expanded="false"
					aria-controls="site-drawer"
					data-drawer-toggle
				>
					<Icon name="menu" size={22} />
					<span class="sr-only">Buka menu</span>
				</button>
			</div>
		</div>
	</div>
</header>

<dialog class="drawer" id="site-drawer" aria-label="Menu dan kontak" data-drawer>
	<div class="drawer__inner shell">
		<nav class="drawer__nav" aria-label="Navigasi utama">
			<ul>
				{navItems.map((item) => (
					<li>
						<a
							href={item.url}
							target={item.target}
							aria-current={isCurrent(item.url) ? "page" : undefined}
						>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<h2 class="drawer__heading" id="drawer-contact">
			Hubungi kami
		</h2>
		<ul class="drawer__contact" aria-labelledby="drawer-contact">
			<li>
				<a href={`tel:${contact.phone}`}>{contact.whatsappDisplay}</a>
			</li>
			<li>
				<a href={`mailto:${contact.email}`}>{contact.email}</a>
			</li>
		</ul>

		<ul class="drawer__social">
			{socials.map((social) => (
				<li>
					<a href={social.href} target="_blank" rel="noopener">
						<Icon name={social.icon} size={20} />
						<span>{social.label}</span>
					</a>
				</li>
			))}
		</ul>
	</div>
</dialog>

<script>
	const header = document.querySelector<HTMLElement>("[data-header]");
	const toggle = document.querySelector<HTMLButtonElement>("[data-drawer-toggle]");
	const drawer = document.querySelector<HTMLDialogElement>("[data-drawer]");

	/**
	 * Scroll direction. The strip leaves on the way down and returns on the way
	 * up, and is always present in the first screenful so the header never
	 * looks like it is missing its own contact details.
	 */
	if (header) {
		let lastY = window.scrollY;
		let queued = false;

		const settle = () => {
			queued = false;
			const y = Math.max(0, window.scrollY);
			const delta = y - lastY;
			// Below the jitter threshold, momentum scroll fires dozens of
			// single-pixel events; acting on those makes the strip stutter.
			if (Math.abs(delta) < 8) return;
			lastY = y;
			const next = y <= 16 || delta < 0 ? "shown" : "hidden";
			if (header.dataset.topbar !== next) header.dataset.topbar = next;
		};

		window.addEventListener(
			"scroll",
			() => {
				if (queued || drawer?.open) return;
				queued = true;
				requestAnimationFrame(settle);
			},
			{ passive: true },
		);

		// A resize can leave scrollY stale (iOS collapses its toolbar), which
		// would make the first gesture after it read as a huge jump.
		window.addEventListener("resize", () => (lastY = Math.max(0, window.scrollY)), {
			passive: true,
		});
	}

	if (drawer && toggle) {
		const setOpen = (open: boolean) => {
			if (open && !drawer.open) {
				// The drawer hangs from the bottom of the strip, so the strip has
				// to be showing before it opens.
				if (header) header.dataset.topbar = "shown";
				drawer.showModal();
			} else if (!open && drawer.open) {
				drawer.close();
			}
			toggle.setAttribute("aria-expanded", String(open));
			document.documentElement.classList.toggle("drawer-open", open);
		};

		toggle.addEventListener("click", () => setOpen(!drawer.open));

		// Escape and the backdrop are the dialog's own gestures; this only
		// mirrors their result back onto the button and the page.
		drawer.addEventListener("close", () => {
			toggle.setAttribute("aria-expanded", "false");
			document.documentElement.classList.remove("drawer-open");
		});

		// Clicks on ::backdrop are dispatched on the dialog itself, so a click
		// that never reached the panel is a click outside it.
		drawer.addEventListener("click", (event) => {
			if (event.target === drawer) drawer.close();
		});

		// Resizing past the breakpoint brings the inline nav back; a modal still
		// open over it would be inert decoration. 1024px is the width the bar
		// needs for the logo, four labels and the CTA on one row.
		matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
			if (event.matches) setOpen(false);
		});
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: var(--z-header);
		background: var(--paper);
		transform: translateY(0);
		transition: transform var(--dur-chrome) var(--ease-out);
	}

	.site-header[data-topbar="hidden"] {
		transform: translateY(calc(-1 * var(--topbar-h)));
	}

	/* Top strip ------------------------------------------------------------ */

	.topbar {
		position: relative;
		background: var(--navy-deep);
		color: var(--on-navy);
	}

	/* The seam: 2px of orange drawn over the bar's top 2px, so the strip keeps
	   its exact height and the sticky transform stays on whole numbers. */
	.topbar::after {
		content: "";
		position: absolute;
		inset: auto 0 -2px 0;
		height: 2px;
		background: var(--orange);
	}

	.topbar__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-24);
		height: var(--topbar-h);
		font-size: var(--fs-caption);
	}

	.topbar ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.topbar__contact {
		display: flex;
		align-items: center;
		/* White for both, told apart by weight, not by a lighter tint. */
		gap: var(--space-16);
		height: 100%;
		min-width: 0;
	}

	.topbar__contact li {
		display: flex;
		align-items: stretch;
		height: 100%;
	}

	.topbar__contact a {
		display: flex;
		align-items: center;
		max-width: 40ch;
		overflow: hidden;
		color: var(--on-navy);
		text-decoration: none;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	/* The number a visitor can actually reach leads, and says so by weight. */
	.topbar__contact a.topbar__phone {
		font-weight: var(--fw-medium);
		font-variant-numeric: tabular-nums;
	}

	.topbar__contact a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.topbar__reach {
		display: flex;
		align-items: center;
		gap: var(--space-16);
		height: 100%;
	}

	.topbar__reachLabel {
		color: var(--on-navy);
		font-size: var(--fs-label);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.topbar__social {
		display: flex;
		align-items: stretch;
		height: 100%;
		gap: var(--space-16);
	}

	.topbar__social li {
		display: flex;
	}

	.topbar__social a {
		display: flex;
		align-items: center;
		gap: var(--space-8);
		color: var(--on-navy);
		text-decoration: none;
	}

	/* On hover the glyph takes brand orange (3.84:1 clears the 3:1 graphics
	   floor) and the label underlines. The glyph lives in Icon.astro, so the
	   selector reaches out of this file's scope. */
	.topbar__social a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.topbar__social a:hover :global(svg) {
		color: var(--orange);
	}

	/* Main bar ------------------------------------------------------------- */

	.mainbar {
		background: var(--paper);
	}

	.mainbar__inner {
		display: flex;
		align-items: center;
		gap: var(--space-24);
		height: var(--mainbar-h);
	}

	.mainbar__logo {
		flex: none;
		display: block;
	}

	.mainbar__logo img {
		display: block;
		width: auto;
		height: var(--logo-h);
		/* The logo keeps its ratio wherever the box is capped; a squashed
		   wordmark is worse than a smaller one. */
		object-fit: contain;
	}

	/* The menu is a rail bolted to the logo: a full-height hairline, then the
	   labels. Stretched, not centred, so each item is a column of the bar. */
	.mainbar__nav {
		align-self: stretch;
		display: flex;
		min-width: 0;
		border-left: 1px solid var(--rule);
		/* A menu an editor grows past the bar scrolls instead of overflowing;
		   keyboard focus still brings each item into view. */
		overflow-x: auto;
		scrollbar-width: none;
	}

	.mainbar__nav ul {
		display: flex;
		align-items: stretch;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.mainbar__nav li {
		display: flex;
	}

	.mainbar__nav a {
		position: relative;
		display: flex;
		align-items: center;
		padding: 0 var(--space-16);
		color: var(--ink);
		font-size: var(--fs-body-s);
		font-weight: var(--fw-medium);
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color var(--dur-control) var(--ease-out),
			color var(--dur-control) var(--ease-out);
	}

	/* The current item's rule lands on the bar's bottom border, so the cut line
	   marks the shelf the item sits on. Hover draws the same rule. */
	.mainbar__nav a::after {
		content: "";
		position: absolute;
		inset: auto 0 0 0;
		height: 2px;
		background: var(--orange);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform var(--dur-control) var(--ease-out);
	}

	.mainbar__nav a:hover {
		background: var(--paper-2);
	}

	.mainbar__nav a:hover::after,
	.mainbar__nav a[aria-current="page"]::after {
		transform: scaleX(1);
	}

	.mainbar__nav a[aria-current="page"] {
		color: var(--orange-deep);
		font-weight: var(--fw-semibold);
	}

	/* The nav scrolls on x, and a scroll container clips: an offset ring would
	   lose its top and bottom edges. Inset instead, still 3.41:1 on white. */
	.mainbar__nav a:focus-visible {
		outline-offset: -3px;
	}

	.mainbar__actions {
		margin-left: auto;
		/* Stretched, not centred: the CTA inside is the bar's full height, so
		   this row has to be the bar's full height for it to fill. */
		align-self: stretch;
		display: flex;
		align-items: stretch;
		gap: var(--space-8);
	}

	/* The one filled control on the chrome, and it fills the bar: a square
	   orange block flush with the bar's top and bottom edges. A 15px label in a
	   40px pill among four menu items is a third menu item; this is not. */
	.cta {
		display: inline-flex;
		align-items: center;
		gap: var(--space-8);
		padding: 0 var(--space-24);
		background: var(--orange-fill);
		color: var(--paper);
		font-size: var(--fs-body-s);
		font-weight: var(--fw-semibold);
		line-height: var(--lh-tight);
		text-decoration: none;
		white-space: nowrap;
		transition: background-color var(--dur-control) var(--ease-out);
	}

	.cta:hover {
		background: var(--orange-deep);
	}

	/* Inset white ring: the global orange one is invisible on this fill, and an
	   offset navy one loses its top edge under the seam. White on it is 4.62:1. */
	.cta:focus-visible {
		outline: 2px solid var(--paper);
		outline-offset: -3px;
	}

	.burger {
		align-self: center;
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 1px solid var(--rule-strong);
		border-radius: var(--radius-control);
		background: var(--paper);
		color: var(--ink);
		cursor: pointer;
		transition:
			border-color var(--dur-control) var(--ease-out),
			color var(--dur-control) var(--ease-out);
	}

	.burger:hover {
		border-color: var(--orange);
		color: var(--orange-deep);
	}

	/* Drawer --------------------------------------------------------------- */

	.drawer {
		position: fixed;
		/* Anchored to the bottom edge of the two bars, and not stretched to the
		   viewport bottom the way a UA dialog with both insets set would be. */
		inset: var(--chrome-h) 0 auto 0;
		width: 100%;
		max-width: none;
		max-height: calc(100dvh - var(--chrome-h));
		margin: 0;
		padding: 0;
		border: 0;
		border-bottom: 1px solid var(--rule-strong);
		background: var(--paper);
		color: var(--ink);
		overflow-y: auto;
		overscroll-behavior: contain;
		opacity: 0;
		translate: 0 -8px;
		transition:
			opacity var(--dur-chrome) var(--ease-out),
			translate var(--dur-chrome) var(--ease-out),
			display var(--dur-chrome) allow-discrete,
			overlay var(--dur-chrome) allow-discrete;
	}

	.drawer[open] {
		opacity: 1;
		translate: 0 0;
	}

	@starting-style {
		.drawer[open] {
			opacity: 0;
			translate: 0 -8px;
		}
	}

	.drawer::backdrop {
		background: rgb(14 36 54 / 45%);
	}

	:global(html.drawer-open) {
		overflow: hidden;
	}

	.drawer__inner {
		padding-block: var(--space-8) var(--space-24);
	}

	.drawer__nav ul,
	.drawer__contact,
	.drawer__social {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.drawer__nav a {
		display: block;
		padding: 14px 0;
		border-bottom: 1px solid var(--rule);
		color: var(--ink);
		font-size: 1.0625rem;
		font-weight: var(--fw-medium);
		text-decoration: none;
	}

	.drawer__nav a[aria-current="page"] {
		color: var(--orange-deep);
		font-weight: var(--fw-semibold);
	}

	/* Small caps over a hairline, the same voice as the strip: the drawer is
	   the strip's content continued, not a second design. */
	.drawer__heading {
		margin: var(--space-24) 0 var(--space-8);
		color: var(--ink-3);
		font-size: var(--fs-label);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.drawer__contact {
		font-size: var(--fs-body-s);
	}

	.drawer__contact a {
		display: block;
		padding: 10px 0;
		color: var(--ink-2);
		text-decoration: none;
	}

	.drawer__contact li:first-child a {
		font-variant-numeric: tabular-nums;
	}

	.drawer__social a {
		display: flex;
		align-items: center;
		gap: var(--space-12);
		padding: 10px 0;
		color: var(--ink-2);
		font-size: var(--fs-body-s);
		text-decoration: none;
	}

	.drawer__nav a:hover,
	.drawer__contact a:hover,
	.drawer__social a:hover {
		color: var(--orange-deep);
	}

	/* Breakpoints ---------------------------------------------------------- */

	/* Below 1024 the bar cannot hold the logo, four labels and the CTA on one
	   row: the menu moves into the drawer, the strip keeps only the details
	   worth a tap, and the CTA sheds its padding to stay a full-height block. */
	@media (max-width: 1023px) {
		.topbar__reach {
			display: none;
		}

		.mainbar__inner {
			/* The bar is 52px here; 24px between the three clusters is space the
			   logo and the CTA can use on a 360px screen. */
			gap: var(--space-16);
		}

		.mainbar__nav {
			display: none;
		}

		.cta {
			padding: 0 var(--space-16);
			font-size: var(--fs-caption);
		}

		.cta :global(svg) {
			width: 18px;
			height: 18px;
		}

		/* Without the script there is no drawer and no burger that works, so the
		   menu has to stay on the page: it takes its own row under the logo. */
		:global(html:not(.js)) .mainbar__inner {
			flex-wrap: wrap;
			height: auto;
			padding-block: var(--space-12);
			row-gap: var(--space-4);
		}

		:global(html:not(.js)) .mainbar__nav {
			order: 3;
			display: block;
			flex-basis: 100%;
			border-left: 0;
			overflow-x: visible;
		}

		:global(html:not(.js)) .mainbar__nav ul {
			flex-wrap: wrap;
		}

		:global(html:not(.js)) .mainbar__nav a {
			padding: 8px var(--space-12);
		}

		:global(html:not(.js)) .mainbar__nav a::after {
			content: none;
		}

		:global(html:not(.js)) .cta {
			align-self: center;
			height: 44px;
		}

		:global(html:not(.js)) .burger {
			display: none;
		}
	}

	@media (min-width: 1024px) {
		.burger {
			display: none;
		}
	}

	/* The email is the longest string in the chrome; below this it is the first
	   thing to go, and the phone number stands alone. */
	@media (max-width: 639px) {
		.topbar__email {
			display: none;
		}

		.cta {
			padding: 0 var(--space-12);
			font-size: var(--fs-label);
		}

		.cta :global(svg) {
			width: 16px;
			height: 16px;
		}
	}

	/* At the 320px reflow floor the logo, the CTA and the burger only just fit. */
	@media (max-width: 359px) {
		.mainbar__inner {
			gap: var(--space-12);
		}

		.cta {
			padding: 0 10px;
		}
	}
</style>
