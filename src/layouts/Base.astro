---
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Seo from "../components/Seo.astro";
import { getSettings } from "../utils/content";
import { siteUrl, titleSeparator } from "../utils/site-identity";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	noindex?: boolean;
	faqSchema?: boolean;
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	noindex,
	faqSchema,
} = Astro.props;

const settings = await getSettings();
const siteTitle = settings.companyName;

const pageDescription = description ?? settings.description;

const pageName = title.trim();
const fullTitle =
	!pageName || pageName === siteTitle
		? [siteTitle, settings.tagline].filter(Boolean).join(titleSeparator)
		: pageName.includes(siteTitle)
			? pageName
			: [pageName, siteTitle].join(titleSeparator);

const origin = siteUrl;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const pageCanonical = canonical ?? `${origin}${path === "/" ? "/" : path}`;
const ogImage = image ?? `${origin}/og.jpg`;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Seo
			fullTitle={fullTitle}
			description={pageDescription}
			canonical={pageCanonical}
			image={ogImage}
			noindex={noindex}
			faqSchema={faqSchema}
		/>
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<Font
			cssVariable="--font-open-runde"
			preload={[
				{ weight: 400, style: "normal" },
				{ weight: 600, style: "normal" },
			]}
		/>
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">
			Lewati ke konten
		</a>
		<Header />

		<main id="main">
			<slot />
		</main>

		<Footer />
	</body>
</html>
