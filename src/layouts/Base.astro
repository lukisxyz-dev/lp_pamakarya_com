---
import { getMenuWithCacheHint, getSiteSettings, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Seo from "../components/Seo.astro";
import { business } from "../data/site";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** "article" for posts: it swaps og:type and the BlogPosting graph. */
	pageType?: "website" | "article";
	/** Published / modified / author, for article pages. */
	articleMeta?: {
		publishedTime?: string | null;
		modifiedTime?: string | null;
		author?: string | null;
	};
	/** Keeps a page out of the index, such as the 404. */
	noindex?: boolean;
	/** Emit FAQPage markup. Only the page showing the FAQ list should ask. */
	faqSchema?: boolean;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	pageType = "website",
	articleMeta,
	noindex,
	faqSchema,
	content,
} = Astro.props;
const settings = await getSiteSettings();
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(settings);

/* Settings -> General wins; a deployment without it canonicalises to itself. */
const siteUrl = (settings.url ?? Astro.url.origin).replace(/\/+$/, "");

/**
 * The description a page does not state itself. The business sentence beats
 * the tagline ("Custom Laser Cutting & Fabrikasi" is a slogan, not an answer),
 * and Seo.astro turns the tagline into the homepage's title instead.
 */
const pageDescription = description ?? business.description;

const separator = settings.seo?.titleSeparator ?? " | ";
const pageName = title.trim();
const fullTitle =
	!pageName || pageName === siteTitle
		? [siteTitle, siteTagline].filter(Boolean).join(separator)
		: pageName.includes(siteTitle)
			? pageName
			: [pageName, siteTitle].join(separator);

const ogImage = image ?? (settings.seo?.defaultOgImage ? null : `${siteUrl}/og.jpg`);

const { cacheHint: settingsHint } = await getSiteSettingsWithCacheHint();
const { cacheHint: menuHint } = await getMenuWithCacheHint("primary");
if (Astro.cache?.enabled) {
	Astro.cache.set({ tags: [...(settingsHint.tags ?? []), ...(menuHint.tags ?? [])] });
}

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType,
	title: pageTitle ?? title,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image: ogImage,
	content,
	articleMeta,
	seo: { ogTitle: pageTitle ?? fullTitle },
	siteName: siteTitle,
	siteUrl,
});
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Seo page={pageCtx} fullTitle={fullTitle} noindex={noindex} faqSchema={faqSchema} />
		{!settings.favicon?.url && (
			<>
				<link rel="icon" href="/favicon.ico" sizes="32x32" />
				<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
				<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
			</>
		)}
		<Font
			cssVariable="--font-open-runde"
			preload={[
				{ weight: 400, style: "normal" },
				{ weight: 600, style: "normal" },
			]}
		/>
		{/* Marks the document as scripted before first paint: the mobile menu
		    lives behind a button, and a reader without the script must still
		    get it, so the CSS that collapses the nav is gated on this class. */}
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<a class="skip-link" href="#main">
			Lewati ke konten
		</a>
		<Header />

		<main id="main">
			<slot />
		</main>

		<Footer />

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
