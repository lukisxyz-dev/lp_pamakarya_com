{
	"name": "pamakarya",
	"version": "0.0.3",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"deploy": "astro build && wrangler deploy",
		"typecheck": "astro check",
		"format": "oxfmt . && prettier --write \"**/*.astro\"",
		"format:check": "oxfmt --check . && prettier --check \"**/*.astro\"",
		"prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.0.0",
		"@astrojs/react": "^6.0.0",
		"@emdash-cms/cloudflare": "^0.37.0",
		"astro": "^7.0.0",
		"emdash": "^0.37.0",
		"react": "19.2.4",
		"react-dom": "19.2.4"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.7",
		"@cloudflare/workers-types": "^5.20260820.1",
		"lefthook": "^2.1.12",
		"oxfmt": "^0.67.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^1.0.0",
		"wrangler": "^4.124.0"
	},
	"packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
	"emdash": {
		"label": "Starter",
		"seed": "seed/seed.json"
	}
}
